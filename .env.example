# Required by the research workflow and Cursor SDK.
CURSOR_API_KEY=

# Explicit account model IDs. GitHub Actions reads repository variables with the same names.
CURSOR_CLAUDE_MODEL=
CURSOR_OPENAI_MODEL=
# Faster account models used outside flagship debate.
CURSOR_SUMMARY_MODEL=composer-2.5
CURSOR_IDEA_MODEL=composer-2.5
OPENALEX_EMAIL=
MAX_DAILY_TOKENS=10000000
MAX_DAILY_RUNS=180
MODEL_CONCURRENCY=3
DOMAIN_CONCURRENCY=3
SUMMARY_CONCURRENCY=3
MODEL_TIMEOUT_MS=600000
MAX_PAPER_TEXT_CHARS=40000
DEBATE_MIN_ROUNDS=3
DEBATE_MAX_ROUNDS=3

# Production canonical URL, for example https://owner.github.io/repository/
SITE_URL=
