---
import Layout from "../layouts/Layout.astro";
import PaperCard from "../components/PaperCard.astro";
import { formatDate, reports } from "../lib/reports";

const latest = reports[0];
const base = import.meta.env.BASE_URL;
const archiveHref = `${base}archive/`;
const reportHref = latest ? `${base}reports/${latest.date}/` : archiveHref;
---

<Layout>
  <section class="hero">
    <div class="shell hero-grid">
      <div>
        <p class="eyebrow">AI 精选 · 每日九篇论文精读</p>
        <h1>每天九篇新论文，<br />读懂<em>方法与结果。</em></h1>
        <p class="hero-copy">
          严格跟踪 arXiv 当日发布批次，分领域整理研究动机、核心方法、实验设置、
          主要结果与计算资源；不足九篇时如实呈现，不跨日补齐。
        </p>
      </div>
      <div class="hero-stat">
        <b>{latest?.papers.length ?? 0}</b>
        <span>{latest ? `${formatDate(latest.date)} 精选论文` : "等待首期论文精读"}</span>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="latest-heading">
    <div class="shell">
      <div class="section-head">
        <div>
          <p class="eyebrow">最新简报</p>
          <h2 id="latest-heading">{latest ? formatDate(latest.date) : "最新简报"}</h2>
          {latest && (
            <p>
              arXiv 发布日期：{latest.date} · 严格同日新发布 {latest.papers.length} 篇
              {latest.releaseStatus === "partial" ? "（部分领域不足 3 篇）" : ""}
            </p>
          )}
        </div>
        {latest && <a class="text-link" href={reportHref}>阅读完整分析 →</a>}
      </div>

      {latest ? (
        <div class="paper-list">
          {latest.papers.map((paper, index) => <PaperCard paper={paper} index={index} />)}
        </div>
      ) : (
        <div class="empty-state">
          <span class="empty-icon" aria-hidden="true">⌁</span>
          <h2>首期简报正在准备中</h2>
          <p>自动化完成第一次运行后，最新论文与研究分析会出现在这里。网站在没有数据时也可正常构建和浏览。</p>
        </div>
      )}
    </div>
  </section>
</Layout>
