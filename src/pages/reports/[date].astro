---
import Layout from "../../layouts/Layout.astro";
import PaperCard from "../../components/PaperCard.astro";
import IdeaCard from "../../components/IdeaCard.astro";
import { formatDate, reports, type Report } from "../../lib/reports";

export function getStaticPaths() {
  return reports.map((report) => ({
    params: { date: report.date },
    props: { report },
  }));
}

interface Props {
  report: Report;
}

const { report } = Astro.props;
const base = import.meta.env.BASE_URL;
const generated = report.generatedAt
  ? new Intl.DateTimeFormat("zh-CN", { dateStyle: "medium", timeStyle: "short" }).format(new Date(report.generatedAt))
  : undefined;
---

<Layout
  title={`${formatDate(report.date)}研究简报 · 每日 arXiv`}
  description={`${formatDate(report.date)} arXiv 精选论文与研究分析。`}
>
  <header class="report-banner">
    <div class="shell">
      <a class="back-link" href={`${base}archive/`}>← 返回全部简报</a>
      <div class="report-title-row">
        <div>
          <p class="eyebrow">每日研究报告</p>
          <h1>{formatDate(report.date)}</h1>
        </div>
        <span class="domain-tag">{report.papers.length} 篇精选</span>
      </div>
      <div class="report-provenance" aria-label="报告来源信息">
        <span>arXiv 发布日期：{report.date}</span>
        {generated && <span>生成于 {generated}</span>}
        {report.model && <span>模型 {report.model}</span>}
        {report.query && <span>检索 {report.query}</span>}
        <span>来源 arXiv</span>
      </div>
      {report.selectionPolicy && <p class="release-policy">抓取规则：{report.selectionPolicy}</p>}
      {report.warnings.length > 0 && (
        <ul class="report-warnings">{report.warnings.map((warning) => <li>{warning}</li>)}</ul>
      )}
    </div>
  </header>

  <div class="shell report-content">
    <div class="paper-list">
      {report.domainResearch.length > 0 && (
        <section id="research-ideas" class="report-ideas" aria-labelledby="research-ideas-heading">
          <p class="eyebrow">最终研究构想</p>
          <h2 id="research-ideas-heading">三个领域的最终可行研究构想</h2>
          <p>先看可执行研究方向，再按需阅读支撑论文。每张卡片可展开查看完整方案。</p>
          <div class="idea-list">
            {report.domainResearch.map((research) => <IdeaCard research={research} expanded />)}
          </div>
        </section>
      )}
      {report.papers.map((paper, index) => (
        <div id={`paper-${index + 1}`}>
          <PaperCard paper={paper} index={index} expanded />
          {(paper.ideas.length > 0 ||
            paper.refinements.length > 0 ||
            paper.debate.length > 0 ||
            paper.references.length > 0) && (
            <section class="analysis-block" aria-label={`${paper.title} 的研究延伸`}>
              <h3>从论文到下一步研究</h3>
              <div class="analysis-grid">
                <div class="analysis-panel">
                  <b>💡 可延伸的想法</b>
                  {paper.ideas.length ? (
                    <ul>{paper.ideas.map((idea) => <li>{idea}</li>)}</ul>
                  ) : (
                    <p>暂无补充。</p>
                  )}
                </div>
                <div class="analysis-panel">
                  <b>↗ 方法改进</b>
                  {paper.refinements.length ? (
                    <ul>{paper.refinements.map((item) => <li>{item}</li>)}</ul>
                  ) : (
                    <p>暂无补充。</p>
                  )}
                </div>
                <div class="analysis-panel">
                  <b>⚖ 值得争论</b>
                  {paper.debate.length ? (
                    <ul>{paper.debate.map((item) => <li>{item}</li>)}</ul>
                  ) : (
                    <p>暂无补充。</p>
                  )}
                </div>
              </div>
              {paper.references.length > 0 && (
                <div class="references">
                  <b>相关参考</b>
                  <ul>
                    {paper.references.map((reference) => (
                      <li>
                        {reference.url ? (
                          <a href={reference.url} target="_blank" rel="noreferrer">{reference.title}</a>
                        ) : (
                          reference.title
                        )}
                        {reference.authors?.length ? ` — ${reference.authors.join(", ")}` : ""}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </section>
          )}
        </div>
      ))}
      {report.papers.length === 0 && (
        <div class="empty-state">
          <h2>{report.releaseStatus === "no-release" ? "本日 arXiv 无新发布" : "本期暂无同日入选论文"}</h2>
          <p>系统不会用旧论文回填；请查看上方的发布日期与严格抓取规则。</p>
        </div>
      )}
    </div>

    <aside class="report-nav" aria-label="本期论文目录">
      <b>本期目录</b>
      {report.domainResearch.length > 0 && <a href="#research-ideas">00 · 三个最终研究构想</a>}
      {report.papers.map((paper, index) => (
        <a href={`#paper-${index + 1}`}>{String(index + 1).padStart(2, "0")} · {paper.titleZh || paper.title}</a>
      ))}
    </aside>
  </div>
</Layout>
